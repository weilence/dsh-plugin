{
  "name": "dsh-zhipu-tools",
  "version": "0.1.0",
  "description": "DSH web 插件（智谱 Coding Plan 工具集，中国区）：① 编程式挂载宿主 in-box dsh-mcp-client，注册智谱官方 MCP 工具 web_search_prime / webReader（credentials 服务解析 key 注入 headers，profile 全局可见，连接监督由 in-box 承担）；② 输入框下方状态栏展示 5小时/7天 用量配额与重置倒计时。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weilence/dsh-plugins.git",
    "directory": "plugins/dsh-zhipu-tools"
  },
  "bugs": {
    "url": "https://github.com/weilence/dsh-plugins/issues"
  },
  "homepage": "https://github.com/weilence/dsh-plugins/tree/develop/plugins/dsh-zhipu-tools#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "zhipu",
    "bigmodel",
    "zai-coding-cn",
    "mcp",
    "web-search",
    "quota"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.2 <0.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "catalog:"
  },
  "devDependencies": {
    "@dsh-plugins/tsdown-config": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-credentials": "catalog:",
    "@deepseek-ai/dsh-host-webserver": "catalog:",
    "@deepseek-ai/dsh-mcp-client": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "clsx": "^2.1.1",
    "lightningcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
